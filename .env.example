# Copier en .env puis adapter.

# URL du site
SITE_URL=https://jean.conquerantsduweb.com

# Compte administrateur (utilisé seulement si WordPress n'est pas encore installé)
ADMIN_USER=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base de données (utilisée seulement si wp-config.php n'existe pas encore)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# Destinataire des messages du formulaire de contact
JR_CONTACT_EMAIL=

# 1 = préproduction (site non indexé), 0 = production
JR_PREPROD=1
